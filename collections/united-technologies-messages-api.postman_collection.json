    "_postman_id": "e7cb7b73-05b9-4c13-a9a1-d7e2a84626ac",
    "name": "Collins Aerospace ARINC Messaging Flights Messages API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Collins Aerospace ARINC Messaging API provides access to the ARINC Global Network for aviation messaging and data exchange. Supports ACARS, OOOI, flight messages, weather data, and operational communications between aircraft, airlines, airports, and ground operations. Part of the legacy United Technologies / RTX Collins Aerospace digital platform.\n\nContact Support:\n Name: Collins Aerospace ARINC Support",
      "type": "text/plain"
    }
  }
